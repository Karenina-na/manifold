CORE_ENV=development
CORE_ADDR=:8080
CORE_DATABASE_PATH=./data/manifold.db
CORE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Trust only the local reverse proxy when using X-Real-IP for rate limiting.
# CORE_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CORE_JWT_SECRET=manifold-dev-secret-change-me
CORE_ADMIN_USERNAME=admin
CORE_ADMIN_PASSWORD_HASH=$2a$10$tT6zviyM5ANs0OHmn18g4eqtgsvaprMNl9n4CTkccoZW9N/aTcd8W
# 生产发布配置可将上面的 hash 留空，由 package:release 生成随机初始密码并写回。
CORE_CONTENT_CACHE_TTL=30s
CORE_STATS_CACHE_TTL=30s
CORE_AUDIT_EVENT_BUFFER=256
# 限流：公开写入口共用配额，登录与 verify 各自更紧（语义见 docs/core.md §3）。
CORE_RATE_LIMIT_PER_MIN=60
CORE_LOGIN_RATE_LIMIT_PER_MIN=5
CORE_MEDIA_MAX_BYTES=5242880
CORE_PUBLIC_URL=
# 自定义种子文件（JSON）。留空时：开发环境使用内置演示数据，生产环境只初始化骨架、内容库为空。
# CORE_SEED_FILE=
# 锚定链（已实现；语义见 docs/chain.md §5）。proof 模式下难度必须落在 1..6，越界拒绝启动。
# CORE_CHAIN_PROOF_MODE=sim
# CORE_CHAIN_DIFFICULTY=6
# CORE_CHAIN_SIM_DELAY=1s
# CORE_CHAIN_BATCH_SIZE=32
# CORE_CHAIN_MAX_BLOCK_ANCHORS=500
# CORE_CHAIN_FLUSH_TIMEOUT=30s
# CORE_CHAIN_ANCHOR_MAX_BYTES=65536
# verify 每请求全链重放，配额比公开提交更紧。
# CORE_CHAIN_VERIFY_RATE_PER_MIN=20
NEXT_PUBLIC_CORE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VITE_CORE_URL=http://localhost:8080
VITE_WEB_URL=http://localhost:3000
ADMIN_PUBLIC_URL=
# GitHub OAuth for comment identities (docs/core.md §auth). 留空时 /auth/me 返回
# providers:[]，Web 的评论入口只显示访客。回调地址必须在 GitHub OAuth App 中
# 注册为 Redirect URI；生产环境填入生产域名对应的地址。
CORE_GITHUB_CLIENT_ID=
CORE_GITHUB_CLIENT_SECRET=
CORE_GITHUB_REDIRECT_URI=

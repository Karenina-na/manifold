{
  "name": "@manifold/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "pnpm run sync-vditor",
    "build": "tsc -b && vite build",
    "prebuild": "pnpm run sync-vditor",
    "sync-vditor": "node scripts/sync-vditor.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test src/lib/*.test.mjs src/i18n/*.test.mjs && node --experimental-strip-types --test src/components/agent/*.test.mjs && tsc -b --pretty false"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@manifold/contracts": "workspace:*",
    "@manifold/render": "workspace:*",
    "@manifold/sdk": "workspace:*",
    "@mantine/core": "^9.5.1",
    "@mantine/dates": "9.5.1",
    "@tanstack/react-query": "^5.101.4",
    "dayjs": "^1.11.23",
    "i18next": "^25.7.4",
    "katex": "^0.18.4",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "vditor": "^3.11.2",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
